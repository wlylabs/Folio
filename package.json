{
  "name": "folio-launchpad",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "compile:contracts": "node scripts/compile-contracts.mjs",
    "watch:launches": "node scripts/watch-launches.mjs",
    "token:list": "node scripts/delete-token.mjs --list",
    "token:delete": "node scripts/delete-token.mjs",
    "test": "node contracts/test/folioSale.test.mjs",
    "forge:build": "forge build",
    "forge:test": "forge test",
    "forge:test:v4": "FOUNDRY_PROFILE=v4 forge test",
    "forge:gas": "forge test --mt test_Gas -vv",
    "slither": "slither .",
    "slither:report": "slither . --checklist --markdown-root . > slither-report.md",
    "deploy:robinhood-mainnet": "forge script contracts/script/DeployFactory.s.sol:DeployFactory --rpc-url robinhood-mainnet --broadcast --verify --verifier blockscout --verifier-url https://robinhoodchain.blockscout.com/api/ -vvv",
    "folio:create": "forge script contracts/script/CreateToken.s.sol:CreateToken --rpc-url robinhood-mainnet --broadcast -vvv",
    "folio:buy": "forge script contracts/script/Buy.s.sol:Buy --rpc-url robinhood-mainnet --broadcast -vvv",
    "folio:sell": "forge script contracts/script/Sell.s.sol:Sell --rpc-url robinhood-mainnet --broadcast -vvv",
    "folio:reserve": "forge script contracts/script/CheckReserve.s.sol:CheckReserve --rpc-url robinhood-mainnet",
    "folio:pause": "forge script contracts/script/Pause.s.sol:Pause --rpc-url robinhood-mainnet --broadcast -vvv",
    "folio:unpause": "forge script contracts/script/Unpause.s.sol:Unpause --rpc-url robinhood-mainnet --broadcast -vvv"
  },
  "dependencies": {
    "@rainbow-me/rainbowkit": "^2.1.5",
    "@supabase/supabase-js": "^2.45.0",
    "@tanstack/react-query": "^5.51.0",
    "@tiptap/react": "^2.6.6",
    "@tiptap/starter-kit": "^2.6.6",
    "marked": "^15.0.12",
    "next": "^14.2.35",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "sanitize-html": "^2.17.6",
    "viem": "^2.19.0",
    "wagmi": "^2.12.0"
  },
  "devDependencies": {
    "@ethereumjs/common": "^4.4.0",
    "@ethereumjs/tx": "^5.4.0",
    "@ethereumjs/util": "^9.1.0",
    "@ethereumjs/vm": "^8.1.1",
    "@foundry-rs/forge": "^1.7.1",
    "@openzeppelin/contracts": "^5.6.1",
    "@openzeppelin/contracts-upgradeable": "^5.6.1",
    "@uniswap/v4-core": "^1.0.2",
    "@uniswap/v4-periphery": "^1.0.3",
    "@types/node": "^20.14.15",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@types/sanitize-html": "^2.16.1",
    "eslint": "^8.57.1",
    "eslint-config-next": "^14.2.35",
    "solc": "^0.8.26",
    "typescript": "^5.5.4"
  }
}
