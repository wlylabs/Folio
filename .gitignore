# foundry
contracts/cache/
contracts/out/
# The `v4` profile's artifacts. Separate from the paris build above so a cancun
# compile of the migration suite never overwrites the bytecode that ships.
contracts/cache-v4/
contracts/out-v4/
cache/

# forge script transaction logs. `contracts/cache/<script>/` is where forge
# writes the "sensitive values" copy of a run, and it is already covered by
# `contracts/cache/` above — keep it that way.
#
# `broadcast/` is only a local record: the durable one is
# `deployments/robinhood-mainnet.json`, which is committed, plus the explorer.
broadcast/

# Generated by `npm run slither:report`. The reviewed findings and their status
# live in DEPLOYMENT.md, which is the version worth reading.
slither-report.md

# What the intro film fetches to build itself: half a megabyte of base64
# webfonts for render.mjs, and a ~120 MB voice model for narrate.mjs. Both are
# one URL away and neither belongs in the tree. The films themselves are
# committed, and so is the narration — inside the voiced cut's audio track.
scripts/intro-video/.cache/
scripts/intro-video/*.wav
